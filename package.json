{
  "name": "custom-ssr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "url": "https://github.com/iamrafalgurbisz/custom-ssr"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build:client": "vite build --outDir dist/client --manifest",
    "build:server": "vite build --outDir dist/server --ssr src/entry-server.tsx",
    "build:ssg": "tsx scripts/prerender.ts",
    "build:server-entry": "esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server-entry.js --packages=external",
    "build": "npm run build:client && npm run build:server && npm run build:ssg && npm run build:server-entry",
    "preview": "node dist/server-entry.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "escape-html": "^1.0.3",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "redis": "^6.2.1",
    "serialize-javascript": "^7.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/escape-html": "^1.0.4",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/serialize-javascript": "^5.0.4",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "sass": "^1.104.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true
  }
}
